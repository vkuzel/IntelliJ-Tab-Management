<idea-plugin>
    <id>com.vkuzel.intellij.tabmanagement</id>
    <name>Tab Management</name>
    <version>0.0.1</version>

    <idea-version since-build="261"/>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <bundledKeymap file="Tab Management.xml"/>
    </extensions>

    <actions>
        <action id="tm.MoveTabLeft" class="com.vkuzel.intellij.tabmanagement.MoveTabLeft"
                text="Move Tab Left">
            <keyboard-shortcut first-keystroke="control shift PAGE_UP" keymap="$default"/>
        </action>
        <action id="tm.MoveTabRight" class="com.vkuzel.intellij.tabmanagement.MoveTabRight"
                text="Move Tab Right">
            <keyboard-shortcut first-keystroke="control shift PAGE_DOWN" keymap="$default"/>
        </action>

        <action id="tm.SwitchToPrevTabGroup" class="com.vkuzel.intellij.tabmanagement.SwitchToPrevTabGroup"
                text="Switch Focus to Previous Tab Group">
            <keyboard-shortcut first-keystroke="control alt PAGE_UP" keymap="$default"/>
        </action>
        <action id="tm.SwitchToNextTabGroup" class="com.vkuzel.intellij.tabmanagement.SwitchToNextTabGroup"
                text="Switch Focus to Next Tab Group">
            <keyboard-shortcut first-keystroke="control alt PAGE_DOWN" keymap="$default"/>
        </action>

        <action id="tm.MoveTabToPrevTabGroup" class="com.vkuzel.intellij.tabmanagement.MoveTabToPrevTabGroup"
                text="Move Tab to Previous Tab Group">
            <keyboard-shortcut first-keystroke="control alt shift PAGE_UP" keymap="$default"/>
        </action>
        <action id="tm.MoveTabToNextTabGroup" class="com.vkuzel.intellij.tabmanagement.MoveTabToNextTabGroup"
                text="Move Tab to Next Tab Group">
            <keyboard-shortcut first-keystroke="control alt shift PAGE_DOWN" keymap="$default"/>
        </action>
    </actions>
</idea-plugin>
